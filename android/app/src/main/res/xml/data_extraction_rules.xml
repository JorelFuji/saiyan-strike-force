        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:vulcan_fitness_database_key" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:vulcan_fitness_database_key" />
    </device-transfer>
